<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">iranimij_badger_listing.iranimij_badger_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Badger</label>
            </button>
        </buttons>
        <spinner>iranimij_badger_columns</spinner>
        <deps>
            <dep>iranimij_badger_listing.iranimij_badger_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="iranimij_badger_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">badger_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Iranimij_Badger::badger_manage</aclResource>
        <dataProvider class="Iranimij\Badger\Ui\DataProvider\BadgerListingDataProvider" name="iranimij_badger_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>badger_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete selected badgers?</message>
                        <title translate="true">Delete Badgers</title>
                    </confirm>
                    <url path="badger/badger/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="enable">
                <settings>
                    <url path="badger/badger/massEnable"/>
                    <type>enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="disable">
                <settings>
                    <url path="badger/badger/massDisable"/>
                    <type>disable</type>
                    <label translate="true">Disable</label>
                </settings>
            </action>
            <action name="duplicate">
                <settings>
                    <url path="badger/badger/massDuplicate"/>
                    <type>duplicate</type>
                    <label translate="true">Duplicate</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="iranimij_badger_columns">
        <settings>
            <editorConfig>
                <param name="selectProvider" xsi:type="string">iranimij_badger_listing.iranimij_badger_listing.iranimij_badger_columns.ids</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="indexField" xsi:type="string">badger_id</param>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="badger/badger/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">iranimij_badger_listing.iranimij_badger_listing.iranimij_badger_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>badger_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="badger_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name">
            <settings>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="is_enabled" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <filter>select</filter>
                <label translate="true">Enabled</label>
            </settings>
        </column>
        <column name="priority">
            <settings>
                <editor>
                    <editorType>text</editorType>
                </editor>
                <filter>textRange</filter>
                <label translate="true">Priority</label>
            </settings>
        </column>
        <column name="is_exclusive" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <filter>select</filter>
                <label translate="true">Exclusive</label>
            </settings>
        </column>
        <column name="active_from" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Active From</label>
            </settings>
        </column>
        <column name="active_to" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Active To</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Iranimij\Badger\Ui\Component\Listing\Column\BadgerActions">
            <settings>
                <indexField>badger_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
